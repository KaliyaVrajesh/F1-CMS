NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/f1cms
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ML microservice URL (Flask, runs on port 5001)
# Docker Compose sets this automatically to http://ml:5001
# For local development, start the ML service manually: cd ml && python app.py
ML_SERVICE_URL=http://localhost:5001
